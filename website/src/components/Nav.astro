---
import ThemeToggle from "./ui/ThemeToggle.tsx";
import { VERSION, GITHUB, STARS, starsLabel } from "../site";
import { Icon } from "astro-icon/components";

const stars = starsLabel(STARS);
const path = Astro.url.pathname;
const isDocs = path.startsWith("/docs/") && !path.startsWith("/docs/native-modules");
const TABS = [
  { href: "/", label: "Home", icon: "lucide:house", active: path === "/" },
  { href: "/docs/introduction", label: "Docs", icon: "lucide:book-open", active: isDocs },
  { href: "/docs/native-modules/overview", label: "Native", icon: "lucide:puzzle", active: path.startsWith("/docs/native-modules") },
  { href: "/roadmap", label: "Roadmap", icon: "lucide:map", active: path.startsWith("/roadmap") },
];
const LINKS = [
  { href: "/docs/introduction", label: "Docs" },
  { href: "/roadmap", label: "Roadmap" },
  { href: "/docs/native-modules/overview", label: "Native Modules" },
];
---

<header
  id="site-nav"
  class="sticky top-0 z-50 border-b border-transparent backdrop-blur transition-colors"
>
  <div class="wrap flex h-16 items-center justify-between">
    <div class="flex items-center gap-2">
      <a
        href="/"
        class="flex shrink-0 items-center gap-2 whitespace-nowrap text-base font-medium tracking-tight"
        aria-label="Bunmaska home"
      >
        <img src="/logo-nav.png" alt="" width="36" height="36" class="h-9 w-9" />
        bunmaska
      </a>
      <a
        href="/docs/changelog"
        class="tag hidden whitespace-nowrap font-mono transition-colors hover:text-text min-[430px]:inline-flex"
        style="height:1.35rem;"
        title="Changelog"
      >
        v{VERSION}
      </a>
    </div>

    <nav class="flex items-center gap-2" aria-label="Primary">
      <div class="hidden items-center gap-2 md:flex">
        {
          LINKS.map((l) => (
            <a
              href={l.href}
              class="rounded-sm px-3 py-2 text-sm text-text-muted transition-colors hover:text-text"
            >
              {l.label}
            </a>
          ))
        }
      </div>
      <a
        href={GITHUB}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Star Bunmaska on GitHub"
        class="ml-1 inline-flex h-9 items-center gap-1.5 rounded-[var(--radius-sm)] border border-[var(--border)] px-2.5 text-sm text-text-muted transition-colors hover:text-text"
      >
        <Icon name="mdi:github" class="h-5 w-5" />
        <span class="hidden items-center gap-1.5 md:inline-flex"
          ><Icon name="lucide:star" class="h-3.5 w-3.5" />Star{stars && <span class="font-mono text-xs text-text-faint">{stars}</span>}</span
        >
      </a>
      <span class="ml-1">
        <ThemeToggle client:load />
      </span>
    </nav>
  </div>

</header>

<!-- Outside the header: its backdrop-filter would become the containing
     block for this fixed panel and crush it into the 64px bar. -->
  <div
    id="mobile-menu"
    hidden
    class="fixed inset-x-0 top-16 z-40 overflow-y-auto border-t border-border md:hidden"
    style="bottom: calc(3.75rem + env(safe-area-inset-bottom, 0px)); background: var(--bg);"
  >
    <nav class="wrap flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        LINKS.map((l) => (
          <a
            href={l.href}
            class="rounded-sm px-3 py-3.5 text-base transition-colors hover:bg-bg-subtle"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href="/docs/migrating/parity"
        class="rounded-sm px-3 py-3.5 text-base transition-colors hover:bg-bg-subtle">API Parity</a
      >
      <a
        href="/docs/changelog"
        class="rounded-sm px-3 py-3.5 text-base transition-colors hover:bg-bg-subtle"
        >Changelog <span class="font-mono text-sm text-text-faint">v{VERSION}</span></a
      >
      <a
        href={GITHUB}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 flex items-center gap-2.5 border-t border-border px-3 pt-5 pb-3.5 text-base text-text-muted transition-colors hover:text-text"
        ><Icon name="mdi:github" class="h-5 w-5" />Star on GitHub{stars && <span class="font-mono text-sm text-text-faint">{stars}</span>}</a
      >
    </nav>
  </div>

  <!-- Mobile app chrome: a bottom tab bar, Instagram-style. Fixed, above the
       iPhone home indicator via safe-area, hidden from md up where the top
       nav carries the links. The Menu tab drives the same panel as before. -->
  <nav
    id="bottom-nav"
    class="fixed inset-x-0 bottom-0 z-50 border-t border-border md:hidden"
    style="background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); padding-bottom: env(safe-area-inset-bottom, 0px);"
    aria-label="Mobile"
  >
    <ul class="grid h-[3.75rem] grid-cols-5">
      {
        TABS.map((t) => (
          <li>
            <a
              href={t.href}
              aria-current={t.active ? "page" : undefined}
              class:list={[
                "flex h-full flex-col items-center justify-center gap-1 text-[0.6875rem] font-medium transition-colors",
                t.active ? "text-accent-text" : "text-text-faint",
              ]}
            >
              <Icon name={t.icon} class="h-[1.35rem] w-[1.35rem]" />
              {t.label}
            </a>
          </li>
        ))
      }
      <li>
        <button
          id="nav-toggle"
          type="button"
          class="flex h-full w-full flex-col items-center justify-center gap-1 text-[0.6875rem] font-medium text-text-faint transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Icon name="lucide:menu" class="menu-icon h-[1.35rem] w-[1.35rem]" />
          <Icon name="lucide:x" class="close-icon hidden h-[1.35rem] w-[1.35rem]" />
          Menu
        </button>
      </li>
    </ul>
  </nav>

<style>
  /* Transparent over the hero; a blurred, bordered bar appears only on scroll. */
  #site-nav {
    background: transparent;
    backdrop-filter: none;
  }
  #site-nav.scrolled,
  #site-nav.menu-open {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--border);
  }

  @media (prefers-reduced-motion: no-preference) {
    #mobile-menu:not([hidden]) {
      animation: menu-in 0.18s ease-out;
    }
    @keyframes menu-in {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>

<script>
  const nav = document.getElementById("site-nav");
  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle("scrolled", window.scrollY > 8);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      menu.hidden = !open;
      // The panel is opaque and full-height, so the page behind must not
      // scroll, and the transparent-over-hero bar must become a real surface.
      nav?.classList.toggle("menu-open", open);
      document.body.style.overflow = open ? "hidden" : "";
      toggle.querySelector(".menu-icon")?.classList.toggle("hidden", open);
      toggle.querySelector(".close-icon")?.classList.toggle("hidden", !open);
      toggle.classList.toggle("text-accent-text", open);
    };
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.hidden) setOpen(false);
    });
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false)),
    );
    // Snap back to the desktop layout if the viewport grows past the md breakpoint.
    window
      .matchMedia("(min-width: 768px)")
      .addEventListener("change", (e) => {
        if (e.matches) setOpen(false);
      });
  }
</script>
