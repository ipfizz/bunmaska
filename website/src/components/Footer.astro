---
import { VERSION, GITHUB, NPM } from "../site";

const cols = [
  {
    title: "Docs",
    links: [
      { href: "/docs/introduction", label: "Introduction" },
      { href: "/docs/quickstart", label: "Quickstart" },
      { href: "/docs/native-modules/overview", label: "Native Modules" },
      { href: "/docs/migrating-from-electron", label: "Migrating" },
    ],
  },
  {
    title: "Reference",
    links: [
      { href: "/docs/api/app", label: "API Reference" },
      { href: "/docs/migrating/parity", label: "API Parity" },
      { href: "/docs/platforms", label: "Platform Support" },
      { href: "/alternatives", label: "Electron alternatives" },
    ],
  },
  {
    title: "Compare",
    links: [
      { href: "/docs/compare/bunmaska-vs-electron", label: "vs Electron" },
      { href: "/compare/electrobun", label: "vs Electrobun" },
      { href: "/compare/tauri", label: "vs Tauri" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: GITHUB, label: "Star on GitHub", external: true },
      { href: NPM, label: "npm", external: true },
      { href: "/roadmap", label: "Roadmap" },
      { href: "/docs/changelog", label: "Changelog" },
      { href: "/about", label: "About" },
    ],
  },
];
---

<footer class="border-t border-border">
  <div class="wrap grid grid-cols-2 gap-x-6 gap-y-8 py-10 md:grid-cols-3 md:gap-10 lg:grid-cols-5 lg:py-14">
    <div class="col-span-2 md:col-span-3 lg:col-span-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="flex items-center gap-2 text-base font-medium tracking-tight"
          ><img src="/logo-nav.png" alt="" width="28" height="28" class="h-7 w-7" />bunmaska</span
        >
        <a
          href="/docs/changelog"
          class="tag whitespace-nowrap font-mono hover:text-text"
          style="height:1.3rem;"
          title="Changelog">v{VERSION}</a
        >
      </div>
      <p class="mt-3 max-w-[26ch] text-base text-text-muted">
        <span class="serif-note"
          >No browser to ship.<br />No native build to break.</span
        >
      </p>
    </div>

    {
      cols.map((col) => (
        <div>
          <p class="eyebrow mb-2 md:mb-3">{col.title}</p>
          <ul class="md:space-y-2">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="footer-link text-sm text-text-muted transition-colors hover:text-text"
                  {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-border">
    <div
      class="wrap flex flex-col items-start justify-between gap-2 py-5 text-[0.8125rem] text-text-faint sm:flex-row sm:items-center sm:text-sm"
    >
      <span
        >© 2026 Bunmaska, named after the <a href="/about" class="underline decoration-border underline-offset-2 hover:text-text">bun maska</a> at an Irani cafe near
        you. No Chromium was shipped in the making of this.</span
      >
      <span><span class="font-mono">v{VERSION}</span> · MIT. Go wild.</span>
    </div>
  </div>
</footer>
