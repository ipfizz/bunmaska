{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "examples/**",
      "tools/**",
      "scripts/**",
      "website/src/**/*.ts",
      "website/src/**/*.tsx",
      "*.json",
      "*.md",
      "!**/node_modules",
      "!**/.admin",
      "!examples/**/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noDebugger": "error",
        "noEmptyBlockStatements": "error"
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noDefaultExport": "off",
        "useNamingConvention": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "overrides": [
    {
      "includes": ["src/main/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/platform/macos/**",
                      "**/platform/linux/**",
                      "**/platform/windows/**",
                      "**/platform/cef/**"
                    ],
                    "message": "D024: api/ reaches a backend only through platform/index.ts, native.ts and services.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/platform/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../api/**", "../../api/**", "**/bootstrap", "**/native-app"],
                    "message": "D024: platform/ never imports api/; contracts live in platform/services.ts and native.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/platform/macos/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../api/**", "../../api/**", "**/bootstrap", "**/native-app"],
                    "message": "D024: platform/ never imports api/; contracts live in platform/services.ts and native.ts."
                  },
                  {
                    "group": ["**/linux/**", "**/windows/**", "**/cef/**"],
                    "message": "D024: a backend never imports another backend; share through a platform/ root file."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/platform/linux/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../api/**", "../../api/**", "**/bootstrap", "**/native-app"],
                    "message": "D024: platform/ never imports api/; contracts live in platform/services.ts and native.ts."
                  },
                  {
                    "group": ["**/macos/**", "**/windows/**", "**/cef/**"],
                    "message": "D024: a backend never imports another backend; share through a platform/ root file."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/platform/cef/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../api/**", "../../api/**", "**/bootstrap", "**/native-app"],
                    "message": "D024: platform/ never imports api/; contracts live in platform/services.ts and native.ts."
                  },
                  {
                    "group": ["**/linux/**", "**/windows/**"],
                    "message": "D024: the Blink backend reuses only the macOS window code (D048); share the rest through a platform/ root file."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/main/platform/windows/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../api/**", "../../api/**", "**/bootstrap", "**/native-app"],
                    "message": "D024: platform/ never imports api/; contracts live in platform/services.ts and native.ts."
                  },
                  {
                    "group": ["**/macos/**", "**/linux/**", "**/cef/**"],
                    "message": "D024: a backend never imports another backend; share through a platform/ root file."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
