#!/bin/sh
# Format staged files with Biome before they are committed; lint, type-check and
# tests stay in `validate`, so this hook never blocks a commit.
#
# Enable once per clone:  git config core.hooksPath .githooks
# (or run `bun run setup:hooks`). See .admin/CONTRIBUTING.md.

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found on PATH; skipping Biome format" >&2
  exit 0
fi

# Re-adding a file that also has unstaged edits would commit those edits.
partial=$(git diff --name-only)

bunx biome format --write --staged >/dev/null 2>&1 || true

git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
  case "$file" in
    *.ts | *.tsx | *.js | *.jsx | *.mjs | *.json | *.css) ;;
    *) continue ;;
  esac
  if printf '%s\n' "$partial" | grep -qxF -- "$file"; then
    echo "pre-commit: $file is partly staged; formatted in the working tree only" >&2
  else
    git add -- "$file"
  fi
done

exit 0
